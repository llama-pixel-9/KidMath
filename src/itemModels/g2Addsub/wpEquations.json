[
  {
    "id": "wp-g2-both-parts-unknown",
    "blueprintId": "wp-g2-both-parts-unknown",
    "modeId": "wordProblems",
    "subskill": "partWholeStories",
    "family": "conceptual",
    "structureType": "bothAddendsUnknown",
    "grade": "2",
    "levelRange": [
      4,
      6
    ],
    "standards": {
      "ccss": [
        "2.OA.A.1"
      ],
      "tx": [
        "2.4C",
        "2.7C"
      ],
      "fl": [
        "MA.2.AR.1.1"
      ],
      "va": [
        "2.CE.1c"
      ],
      "ga": [
        "2.NR.2.3"
      ]
    },
    "difficulty": "easy",
    "format": "choice",
    "widget": null,
    "representationType": "verbalContext",
    "template": {
      "prompt": "{name} has {total} {object_plural}. {name} puts some in {placeA} and the rest in {placeB}. Which shows how many {object_plural} could be in {theA} and in {theB}?"
    },
    "slots": {
      "name": {
        "kind": "name"
      },
      "object": {
        "kind": "object",
        "skill": "addition",
        "band": "2-3",
        "minAppeal": 2,
        "categories": [
          "toys-games",
          "school-art",
          "collecting-nature"
        ]
      },
      "t1": {
        "kind": "int",
        "min": 0,
        "max": 6
      },
      "t2": {
        "kind": "int",
        "min": 0,
        "max": 6
      },
      "o1": {
        "kind": "int",
        "min": 0,
        "max": 8
      },
      "oPick": {
        "kind": "int",
        "min": 0,
        "max": 8
      },
      "o2": {
        "kind": "expr",
        "expr": "oPick % (9 - o1)",
        "format": "int"
      },
      "p1": {
        "kind": "expr",
        "expr": "10 * t1 + o1",
        "format": "int"
      },
      "p2": {
        "kind": "expr",
        "expr": "10 * t2 + o2",
        "format": "int"
      },
      "place": {
        "kind": "int",
        "min": 0,
        "max": 3
      },
      "kTenPick": {
        "kind": "int",
        "min": 0,
        "max": 1
      },
      "sPick": {
        "kind": "int",
        "min": 0,
        "max": 8
      },
      "kOnePick": {
        "kind": "int",
        "min": 0,
        "max": 1
      },
      "kTot": {
        "kind": "int",
        "min": 0,
        "max": 1
      },
      "total": {
        "kind": "expr",
        "expr": "p1 + p2",
        "format": "int"
      },
      "placeA": {
        "kind": "expr",
        "expr": "place == 0 ? 'a red box' : place == 1 ? 'a red bin' : place == 2 ? 'a bag' : 'a big tub'",
        "format": "text"
      },
      "placeB": {
        "kind": "expr",
        "expr": "place == 0 ? 'a blue box' : place == 1 ? 'a blue bin' : place == 2 ? 'a basket' : 'a small tub'",
        "format": "text"
      },
      "theA": {
        "kind": "expr",
        "expr": "place == 0 ? 'the red box' : place == 1 ? 'the red bin' : place == 2 ? 'the bag' : 'the big tub'",
        "format": "text"
      },
      "theB": {
        "kind": "expr",
        "expr": "place == 0 ? 'the blue box' : place == 1 ? 'the blue bin' : place == 2 ? 'the basket' : 'the small tub'",
        "format": "text"
      },
      "kTen": {
        "kind": "expr",
        "expr": "kTenPick == 1 ? (o2 >= 1 ? 1 : 0) : (o1 >= 1 ? 0 : 1)",
        "format": "int"
      },
      "sTen": {
        "kind": "expr",
        "expr": "kTen == 1 ? 1 + sPick % max(1, o2) : 1 + sPick % max(1, o1)",
        "format": "int"
      },
      "tenA": {
        "kind": "expr",
        "expr": "kTen == 0 ? p1 - sTen : p1 + sTen",
        "format": "int"
      },
      "tenB": {
        "kind": "expr",
        "expr": "kTen == 0 ? p2 - 10 + sTen : p2 + 10 - sTen",
        "format": "int"
      },
      "kOne": {
        "kind": "expr",
        "expr": "o2 == 0 ? 1 : (o1 == 0 ? 0 : kOnePick)",
        "format": "int"
      },
      "oneA": {
        "kind": "expr",
        "expr": "kOne == 0 ? p1 + 2 : p1 - 1",
        "format": "int"
      },
      "oneB": {
        "kind": "expr",
        "expr": "kOne == 0 ? p2 - 1 : p2 + 2",
        "format": "int"
      },
      "keyPair": {
        "kind": "expr",
        "expr": "p1 + ' and ' + p2",
        "format": "text"
      },
      "tenPair": {
        "kind": "expr",
        "expr": "tenA + ' and ' + tenB",
        "format": "text"
      },
      "onePair": {
        "kind": "expr",
        "expr": "oneA + ' and ' + oneB",
        "format": "text"
      },
      "totPair": {
        "kind": "expr",
        "expr": "kTot == 0 ? p1 + ' and ' + total : total + ' and ' + p2",
        "format": "text"
      },
      "sumTen": {
        "kind": "expr",
        "expr": "kTen == 0 ? total - 10 : total + 10",
        "format": "int"
      },
      "sumOne": {
        "kind": "expr",
        "expr": "total + 1",
        "format": "int"
      },
      "tenWord": {
        "kind": "expr",
        "expr": "kTen == 0 ? 'ten less' : 'ten more'",
        "format": "text"
      }
    },
    "constraints": [
      "o1 + o2 >= 1",
      "p1 >= 5 && p2 >= 5",
      "total >= 20",
      "total <= 99",
      "ones(p1) + ones(p2) <= 9",
      "ones(tenA) + ones(tenB) <= 9",
      "ones(oneA) + ones(oneB) <= 9",
      "tenA >= 5 && tenB >= 5 && oneA >= 5 && oneB >= 5",
      "tenA != p1 && tenA != p2 && tenB != p1 && tenB != p2",
      "oneA != p2 && oneB != p1",
      "p1 != p2",
      "p1 != 10",
      "p2 != 10",
      "object.id == 'marble' || object.id == 'bead' || object.id == 'button' || object.id == 'seashell' || object.id == 'acorn' || object.id == 'smooth-rock' || object.id == 'toy-car' || object.id == 'crayon' || object.id == 'pom-pom' || object.id == 'building-brick' || object.id == 'snap-cube' || object.id == 'trading-card' || object.id == 'gemstone' || object.id == 'domino' || object.id == 'magnetic-tile' || object.id == 'loom-band'",
      "object.count_one_kid != null && total <= sum(drop(object.count_one_kid, 1))"
    ],
    "answer": {
      "expr": "keyPair",
      "type": "text"
    },
    "distractors": [
      {
        "expr": "tenPair",
        "mistake": "offByTen"
      },
      {
        "expr": "onePair",
        "mistake": "offByOne"
      },
      {
        "expr": "totPair",
        "mistake": "pairDoesNotMakeTotal"
      }
    ],
    "hint": {
      "nudge": "The question asks for two numbers that make {total} together. Add each pair and look for {total}.",
      "steps": [
        "Add the two numbers in each choice.",
        "Add the tens, then add the ones.",
        "Only one pair makes exactly {total}. That pair could be the {object_plural} in {theA} and in {theB}."
      ],
      "picture": null,
      "example": "auto",
      "feedback": {
        "offByTen": "Those two numbers make {sumTen}, {tenWord} than {total}. Add the tens again.",
        "offByOne": "Those two numbers make {sumOne}, one more than {total}. Add the ones again.",
        "pairDoesNotMakeTotal": "{name} has {total} {object_plural} in all. If all {total} go in one place, nothing is left for the other place."
      },
      "solution": {
        "steps": [
          "Add each pair. Only {p1} + {p2} makes {total}.",
          "So {name} could put {p1} {object_plural} in {theA} and {p2} in {theB}."
        ],
        "answer": "keyPair"
      }
    },
    "provenance": {
      "author": "larkit",
      "checkedAgainst": [
        "CCSS 2.OA.A.1",
        "TEKS 2.4C, 2.7C",
        "FL B.E.S.T. MA.2.AR.1.1",
        "VA SOL 2023 2.CE.1c",
        "GA K-12 2021 2.NR.2.3",
        "CCSS Progressions K-5 OA, Table 1"
      ]
    }
  },
