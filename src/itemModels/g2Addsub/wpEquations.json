  {
    "id": "wp-g2-box-middle",
    "blueprintId": "wp-g2-box-middle",
    "modeId": "wordProblems",
    "subskill": "missingNumber",
    "family": "conceptual",
    "structureType": "equationUnknownMiddle",
    "grade": "2",
    "levelRange": [
      4,
      6
    ],
    "standards": {
      "ccss": [
        "2.NBT.B.5"
      ],
      "tx": [
        "2.4B"
      ],
      "fl": [
        "MA.2.AR.2.2"
      ],
      "va": [
        "2.CE.1b"
      ],
      "ga": [
        "2.NR.2.4"
      ]
    },
    "difficulty": "moderate",
    "format": "number",
    "widget": "numberPad",
    "representationType": "symbolic",
    "template": {
      "prompt": "What number makes this true? {a} {sign} □ = {c}"
    },
    "slots": {
      "cellPick": {
        "kind": "int",
        "min": 0,
        "max": 16
      },
      "sgn": {
        "kind": "expr",
        "expr": "cellPick < 10 ? 0 : 1",
        "format": "int"
      },
      "rgWant": {
        "kind": "expr",
        "expr": "(cellPick >= 3 && cellPick < 10) || cellPick >= 13 ? 1 : 0",
        "format": "int"
      },
      "aPlus": {
        "kind": "int",
        "min": 30,
        "max": 58
      },
      "xPlus": {
        "kind": "int",
        "min": 11,
        "max": 39
      },
      "aMinus": {
        "kind": "int",
        "min": 30,
        "max": 99
      },
      "xMinus": {
        "kind": "int",
        "min": 11,
        "max": 69
      },
      "a": {
        "kind": "expr",
        "expr": "sgn == 0 ? aPlus : aMinus",
        "format": "int"
      },
      "x": {
        "kind": "expr",
        "expr": "sgn == 0 ? xPlus : xMinus",
        "format": "int"
      },
      "c": {
        "kind": "expr",
        "expr": "sgn == 0 ? a + x : a - x",
        "format": "int"
      },
      "sign": {
        "kind": "expr",
        "expr": "sgn == 0 ? '+' : '−'",
        "format": "text"
      },
      "big": {
        "kind": "expr",
        "expr": "sgn == 0 ? c : a",
        "format": "int"
      },
      "small": {
        "kind": "expr",
        "expr": "sgn == 0 ? a : c",
        "format": "int"
      },
      "trade": {
        "kind": "expr",
        "expr": "ones(big) < ones(small) ? 1 : 0",
        "format": "int"
      },
      "slip": {
        "kind": "expr",
        "expr": "tens(big) - tens(small) + abs(ones(big) - ones(small))",
        "format": "int"
      },
      "onesSmall": {
        "kind": "expr",
        "expr": "ones(small) == 1 ? '1 one' : ones(small) + ' ones'",
        "format": "text"
      },
      "nudgeLine": {
        "kind": "expr",
        "expr": "sgn == 0 ? 'The question asks what number you add to ' + a + ' to make ' + c + '.' : 'The question asks what number you take away from ' + a + ' to leave ' + c + '.'",
        "format": "text"
      },
      "startLine": {
        "kind": "expr",
        "expr": "'Start at ' + small + '.'",
        "format": "text"
      },
      "countLine": {
        "kind": "expr",
        "expr": "'Count up to ' + big + '. Jump by tens first, then by ones.'",
        "format": "text"
      },
      "lastLine": {
        "kind": "expr",
        "expr": "sgn == 0 ? 'Add up your jumps. That is the number you add to ' + a + '.' : 'Add up your jumps. That is the number taken away from ' + a + '.'",
        "format": "text"
      },
      "fbCompute": {
        "kind": "expr",
        "expr": "sgn == 0 ? 'That adds ' + a + ' and ' + c + '. The = sign means both sides are the same amount, so ' + a + ' and the box together make ' + c + '.' : 'That adds ' + a + ' and ' + c + '. The = sign means both sides are the same amount, so ' + a + ' take away the box leaves ' + c + '.'",
        "format": "text"
      },
      "fbSlip": {
        "kind": "expr",
        "expr": "'To find the box, take ' + small + ' away from ' + big + '. There are not enough ones in ' + big + ' to take away ' + onesSmall + ', so trade 1 ten for 10 ones first.'",
        "format": "text"
      },
      "solCount": {
        "kind": "expr",
        "expr": "'Count up from ' + small + ' to ' + big + '. The jumps add up to ' + x + '.'",
        "format": "text"
      },
      "solCheck": {
        "kind": "expr",
        "expr": "'Check: ' + a + ' ' + sign + ' ' + x + ' = ' + c + '.'",
        "format": "text"
      }
    },
    "constraints": [
      "c >= 11",
      "c <= 69",
      "trade == rgWant",
      "x != a",
      "x != c",
      "trade == 0 || slip != c",
      "trade == 0 || slip != a + c"
    ],
    "answer": {
      "expr": "x",
      "type": "int"
    },
    "distractors": [
      {
        "expr": "a + c",
        "mistake": "equalsMeansCompute"
      },
      {
        "expr": "slip",
        "mistake": "smallerFromLarger",
        "when": "trade == 1"
      },
      {
        "expr": "c",
        "mistake": "answeredWithAGiven"
      }
    ],
    "hint": {
      "nudge": "{nudgeLine}",
      "steps": [
        "{startLine}",
        "{countLine}",
        "{lastLine}"
      ],
      "picture": null,
      "example": "auto",
      "feedback": {
        "equalsMeansCompute": "{fbCompute}",
        "smallerFromLarger": "{fbSlip}",
        "answeredWithAGiven": "The number after the = sign, {c}, is already in the equation. The box is the number that makes both sides the same."
      },
      "solution": {
        "steps": [
          "{solCount}",
          "{solCheck}"
        ],
        "answer": "x"
      }
    },
    "provenance": {
      "author": "larkit",
      "checkedAgainst": [
        "CCSS 2.NBT.B.5",
        "TEKS 2.4B",
        "FL B.E.S.T. MA.2.AR.2.2",
        "VA SOL 2023 2.CE.1b",
        "GA K-12 2021 2.NR.2.4"
      ]
    }
  },
