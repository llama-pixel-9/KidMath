      },
      {
        "expr": "eqBoxSwap",
        "mistake": "solvedForWrongQuantity"
      }
    ],
    "hint": {
      "nudge": "The question asks which equation finds the {colorB} {object_plural}. Start by finding the whole.",
      "steps": [
        "An equation uses an equal sign. Some classes call it a number sentence.",
        "All of {name}'s {object_plural}, {colorA} and {colorB} together, are the whole.",
        "The {colorA} {object_plural} are one part. The {colorB} {object_plural} are the missing part.",
        "To find a missing part, start with the whole and take away the part you know."
      ],
      "picture": null,
      "example": "auto",
      "feedback": {
        "addedInsteadOfSubtracted": "Adding gives more than all of {name}'s {object_plural}. The {colorB} {object_plural} are only part of them, so the equation takes away.",
        "unknownInWrongPlace": "In that equation the box comes first, where the whole goes. You already know the whole. The box should stand for the {colorB} {object_plural}.",
        "solvedForWrongQuantity": "That equation takes all of the {object_plural} away from the box, so the box would be more than all of them. The {colorB} {object_plural} are less than the whole."
      },
      "solution": {
        "steps": [
          "The whole is {total} {object_plural}. The part you know is {part} {colorA} {object_plural}.",
          "Start with the whole and take away the part you know.",
          "The equation is {eqKey}."
        ],
        "answer": "eqKey"
      }
    },
    "provenance": {
      "author": "larkit",
      "checkedAgainst": [
