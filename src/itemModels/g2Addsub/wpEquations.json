        "format": "text"
      },
      "fbGiven": {
        "kind": "expr",
        "expr": "sgn == 0 ? 'That is the number left after taking away. The box is the number you start with, so it is more than ' + c + '.' : 'That is the number you end with. The box is the number you start with, before ' + b + ' is added, so it is less than ' + c + '.'",
        "format": "text"
      },
      "solFirst": {
        "kind": "expr",
        "expr": "sgn == 0 ? 'The box is the start. Put back the ' + b + ' that was taken away.' : 'The box is the start. Take away the ' + b + ' that was added.'",
