        "expr": "nextTen(a) + 10",
        "format": "int"
      }
    },
    "constraints": [
      "ones(a) != 0",
      "ones(a) + b >= 11",
      "nextTen(a) - a != a + b - nextTen(a)"
    ],
    "operation": {
      "op": "+"
    },
    "answer": {
      "expr": "a + b - nextTen(a)",
      "type": "int"
    },
    "distractors": [
      {
        "expr": "nextTen(a) - a",
        "mistake": "stoppedAtTheTen"
      },
      {
        "expr": "b",
        "mistake": "answeredWithAGiven"
      },
      {
        "expr": "a + b",
        "mistake": "equalsMeansCompute"
      }
    ],
    "hint": {
      "nudge": "Both sides must be worth the same. Start by getting {a} up to {ten}.",
      "steps": [
        "{a} needs {toTen} more to make {ten}.",
        "Break {b} into two parts: {toTen} and the rest.",
        "The rest of {b} goes in the box."
      ],
      "picture": {
        "kind": "numberLine",
        "min": "lineLow",
        "max": "lineHigh",
        "mark": "a"
