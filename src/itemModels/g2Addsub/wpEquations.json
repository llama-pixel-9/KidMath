      },
      "eqKey": {
        "kind": "expr",
        "expr": "total + ' − ' + part + ' = □'",
        "format": "text"
      },
      "eqAdd": {
        "kind": "expr",
        "expr": "total + ' + ' + part + ' = □'",
        "format": "text"
      },
      "eqBoxWhole": {
        "kind": "expr",
        "expr": "'□ − ' + part + ' = ' + total",
        "format": "text"
